        "IT10"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "background_save": true,
          "base_uri": "https://localhost:8080/"
        },
        "id": "yHESErcUtddZ",
        "outputId": "6dad0cad-9331-4af2-c3b0-2df8f9b48061"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "SCRAP\n"
          ]
        }
      ],
      "source": [
        "accept = 0\n",
        "rework = 0\n",
        "scrap = 0\n",
        "\n",
        "for i in range(10):\n",
        "    d = float(input(\"Enter diameter of part: \"))\n",
        "\n",
        "    if 24.95 <= d <= 25.05:\n",
        "        print(\"ACCEPT\")\n",
        "        accept += 1\n",
        "\n",
        "    elif 24.90 <= d <= 25.10:\n",
        "        print(\"REWORK\")\n",
        "        rework += 1\n",
        "\n",
        "    else:\n",
        "        print(\"SCRAP\")\n",
        "        scrap += 1\n",
        "\n",
        "print(\"\\n----- BATCH REPORT -----\")\n",
        "print(\"Accepted:\", accept)\n",
        "print(\"Rework:\", rework)\n",
        "print(\"Scrap:\", scrap)"
      ]
    },
