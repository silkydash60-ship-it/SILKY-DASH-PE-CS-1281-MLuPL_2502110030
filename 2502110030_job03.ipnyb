    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6iYUGNGerxI2",
        "outputId": "f808b17f-0525-41b6-fc7e-72fe83344ac2"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Enter total number of parts: 54\n",
            "Enter box size: 7\n",
            "Full boxes: 7\n",
            "Loose parts: 5\n",
            "Audit: True\n"
          ]
        }
      ],
      "source": [
        "total = int(input(\"Enter total number of parts: \"))\n",
        "size = int(input(\"Enter box size: \"))\n",
        "\n",
        "boxes = total // size\n",
        "loose = total % size\n",
        "\n",
        "print(\"Full boxes:\", boxes)\n",
        "print(\"Loose parts:\", loose)\n",
        "print(\"Audit:\", boxes * size + loose == total)"
      ]
    },
