        "id": "AFMPWzBosJqC",
        "outputId": "f7a63d03-e61c-4ca8-ea15-6647183dd22d"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "ACCEPT\n",
            "ACCEPT\n",
            "ACCEPT\n",
            "ACCEPT\n",
            "ACCEPT\n"
          ]
        }
      ],
      "source": [
        "accept = 0\n",
        "rework = 0\n",
        "scrap = 0\n",
        "\n",
        "for i in range(10):\n",
        "    d = float(input(\"Enter diameter: \"))\n",
        "\n",
        "    if 24.95 <= d <= 25.05:\n",
        "        print(\"ACCEPT\")\n",
        "        accept += 1\n",
        "    elif 24.90 <= d <= 25.10:\n",
        "        print(\"REWORK\")\n",
        "        rework += 1\n",
        "    else:\n",
        "        print(\"SCRAP\")\n",
        "        scrap += 1\n",
        "\n",
        "boxes = accept // 4\n",
        "loose = accept % 4\n",
        "\n",
        "print(\"\\n----- END OF SHIFT SUMMARY -----\")\n",
        "print(\"Accepted parts:\", accept)\n",
        "print(\"Rework parts:\", rework)\n",
        "print(\"Scrap parts:\", scrap)\n",
        "print(\"Full boxes:\", boxes)\n",
        "print(\"Loose parts:\", loose)\n",
        "print(\"Audit:\", boxes * 4 + loose == accept)"
      ]
    }
  ],
